extern "duckdb_destroy_error_data" destroy_error_data(e: **ErrorData)

// ## Scalar functions
//
// The function DuckDB calls takes three handles, so its address is an ordinary `&f`. The extra-info
// slot is a `void *` with a destructor DuckDB runs when the function is dropped from the catalog.
extern "duckdb_create_scalar_function" create_scalar_function() -> *ScalarFunction
extern "duckdb_destroy_scalar_function" destroy_scalar_function(f: **ScalarFunction)
extern "duckdb_scalar_function_set_name" scalar_function_set_name(f: *ScalarFunction, name: *u8)
extern "duckdb_scalar_function_add_parameter" scalar_function_add_parameter(f: *ScalarFunction, t: *LogicalType)
extern "duckdb_scalar_function_set_return_type" scalar_function_set_return_type(f: *ScalarFunction, t: *LogicalType)
extern "duckdb_scalar_function_set_function" scalar_function_set_function(f: *ScalarFunction, body: *extern(*FunctionInfo, *DataChunk, *Vector) -> unit)
extern "duckdb_scalar_function_set_extra_info" scalar_function_set_extra_info(f: *ScalarFunction, info: *u8, destroy: *extern(*u8) -> unit)
extern "duckdb_scalar_function_get_extra_info" scalar_function_get_extra_info(info: *FunctionInfo) -> *u8
extern "duckdb_scalar_function_set_error" scalar_function_set_error(info: *FunctionInfo, message: *u8)
extern "duckdb_register_scalar_function" register_scalar_function(con: *Connection, f: *ScalarFunction) -> i32

// The C heap, for the one block DuckDB keeps on the binding's behalf: the slot a scalar function's
// closure lives in, which DuckDB frees through the destructor it was handed.
extern "calloc" calloc(n: usize, size: usize) -> *u8
extern "free" libc_free(p: *u8)

// ## Date and time
extern "duckdb_from_date" from_date(d: Date) -> DateParts
extern "duckdb_to_date" to_date(d: DateParts) -> Date
extern "duckdb_from_timestamp" from_timestamp(t: Timestamp) -> TimestampParts
extern "duckdb_to_timestamp" to_timestamp(t: TimestampParts) -> Timestamp
extern "duckdb_hugeint_to_double" hugeint_to_double(v: Hugeint) -> f64
extern "duckdb_decimal_to_double" decimal_to_double(v: Decimal) -> f64
