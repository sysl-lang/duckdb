module sh.sysl.duckdb
@tests

import sh.sysl.duckdb.c
import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, remove_dir_all, write_text_atomic}
import sysl.process.capture
import sysl.sync.Atomic
import sysl.text.{from_utf8, parse_real, Search, split}
import sysl.threads.current

// The binding's tests, against the DuckDB the machine has. Every query result that can be printed is
// checked against the `duckdb` CLI's own answer to the same SQL (`duckdb -csv -noheader -c …`) — the
// same engine through a different door, so a binding that misread a vector disagrees with it.

private fresh() -> &Connection
    val db = open() match
        Ok(d) -> d
        Err(why) -> panic(s"could not open an in-memory database: ${why.message}")

    db.connect() match
        Ok(con) -> con
        Err(why) -> panic(s"could not connect: ${why.message}")
end fresh

private run(con: &Connection, sql: string) -> &QueryResult
    con.query(sql) match
        Ok(r) -> r
        Err(why) -> panic(s"'$sql' failed: ${why.message}")

// ## The oracle

// The CLI's answer, one row per line. Its standard error comes back too, for the error-path tests.
private cli(sql: string) -> (string, string)
    val out = capture("duckdb", ["-csv", "-noheader", "-c", sql], stderr = true).unwrap()

    (out.text, out.err.unwrap_or(""))
end cli

// A CSV line split into fields, honouring DuckDB's quoting (`"a,b"`, `"q""uote"`).
private fields(line: string) -> Buf[string]
    var out: Buf[string] = buf()
    var cur: Buf[u8] = buf()
    var quoted = false
    var i: usize = 0
    val b = line.bytes

    while i < b.len
        val ch = b[i]

        if quoted then
            if ch == u8('"') && i + 1 < b.len && b[i + 1] == u8('"') then
                cur.push(ch)
                i += 1
            else if ch == u8('"') then
                quoted = false
            else
                cur.push(ch)
        else if ch == u8('"') then
            quoted = true
        else if ch == u8(',') then
            out.push(from_utf8(cur.view()).unwrap())
            cur = buf()
        else
            cur.push(ch)
        i += 1

    out.push(from_utf8(cur.view()).unwrap())
    out
end fields

// One cell as the CLI prints it, for every type whose CLI spelling this can reproduce exactly.
private cell(col: Column, row: usize) -> string
    if col.is_null(row) then return "NULL"

    col.id() match
        Boolean     -> if col.bools().unwrap()[row] then "true" else "false"
        Tinyint     -> s"${col.i8s().unwrap()[row]}"
        Smallint    -> s"${col.i16s().unwrap()[row]}"
        Integer     -> s"${col.i32s().unwrap()[row]}"
        Bigint      -> s"${col.i64s().unwrap()[row]}"
        Utinyint    -> s"${col.u8s().unwrap()[row]}"
        Usmallint   -> s"${col.u16s().unwrap()[row]}"
        Uinteger    -> s"${col.u32s().unwrap()[row]}"
        Ubigint     -> s"${col.u64s().unwrap()[row]}"
        Hugeint     -> s"${col.i128s().unwrap()[row]}"
        Uhugeint    -> s"${col.u128s().unwrap()[row]}"
        Varchar     -> col.text(row).unwrap().unwrap()
        DecimalType -> col.decimal(row).unwrap().unwrap().text()
        _           -> panic(s"no CLI spelling for ${col.id().name()}")
end cell

// Run `sql` through the binding and through the CLI and require every cell to agree. A DOUBLE or FLOAT
// is compared as a number, since the CLI's shortest spelling is not sysl's; everything else as text.
private agrees(con: &Connection, sql: string) -> usize
    val (text, _) = cli(sql)
    val lines = split(text.trim_end(), "\n")
    val r = run(con, sql)
    var n: usize = 0

    loop
        val ch = r.next() match
            Some(x) -> x
            None -> break

        for row in 0..<ch.size()
            val want = fields(lines[n])

            assert_eq(want.len(), ch.columns(), s"row $n has as many fields as columns")

            for col in 0..<ch.columns()
                val v = ch.column(col)

                if v.id() == Double && !v.is_null(row) then
                    assert_eq(v.f64s().unwrap()[row], parse_real(want[col]).unwrap(), s"row $n column $col")
                else if v.id() == Float && !v.is_null(row) then
                    assert_eq(f64(v.f32s().unwrap()[row]), parse_real(want[col]).unwrap(), s"row $n column $col")
                else
                    assert_eq(cell(v, row), want[col], s"row $n column $col of '$sql'")
            n += 1

    assert_eq(n, lines.len, s"as many rows as the CLI printed for '$sql'")
    n
end agrees

// ## Layout

// The structs crossing to C by value or by address, against the header's own `sizeof`/`offsetof`.
@test("the structs that cross to C are the size the header says")
layout()
    assert_eq(sizeof(c.Result), c.RESULT_SIZE, "duckdb_result")
    assert_eq(sizeof(c.Hugeint), c.HUGEINT_SIZE, "duckdb_hugeint")
    assert_eq(sizeof(i128), c.HUGEINT_SIZE, "an i128 is a hugeint's size")
    assert_eq(sizeof(c.Decimal), c.DECIMAL_SIZE, "duckdb_decimal")
    assert_eq(offsetof(c.Decimal, value), c.DECIMAL_VALUE, "duckdb_decimal.value")
    assert_eq(sizeof(c.Interval), c.INTERVAL_SIZE, "duckdb_interval")
    assert_eq(sizeof(Interval), c.INTERVAL_SIZE, "the public Interval a view is read as")
    assert_eq(sizeof(c.StringT), c.STRING_T_SIZE, "duckdb_string_t")
    assert_eq(alignof(c.StringT), c.STRING_T_ALIGN, "duckdb_string_t's alignment")
    assert_eq(offsetof(c.StringT, ptr), c.STRING_T_PTR, "the pointer half of the union")
    assert_eq(sizeof(ListEntry), c.LIST_ENTRY_SIZE, "duckdb_list_entry")
    assert_eq(sizeof(c.TimestampParts), c.TS_PARTS_SIZE, "duckdb_timestamp_struct")
    assert_eq(offsetof(c.TimestampParts, time), c.TS_PARTS_TIME, "duckdb_timestamp_struct.time")
end layout

// ## Columns as views

@test("a BIGINT column is a view of DuckDB's own i64 array")
bigint_view()
    val con = fresh()
    val r = run(con, "SELECT i FROM range(5) t(i)")
    val ch = r.next().unwrap()
    val xs = ch.column(0).i64s().unwrap()

    assert_eq(xs.len, 5, "five rows")
    assert_eq(xs[4], 4, "the last")
    assert(r.next().is_none(), "and one chunk was all of it")
end bigint_view

@test("a reader for the wrong type is refused, naming both")
wrong_type()
    val con = fresh()
    val ch = run(con, "SELECT 1::BIGINT").next().unwrap()

    assert_eq(ch.column(0).f64s().unwrap_err().message, "the column is BIGINT, not DOUBLE", "the refusal")
    assert_eq(ch.column(0).text(0).unwrap_err().message, "the column is BIGINT, not VARCHAR", "text too")
end wrong_type

@test("every integer width, doubles, booleans, strings and NULL agree with the CLI")
mixed_agrees()
    val con = fresh()
    val sql = "SELECT i::TINYINT, (i * 300)::SMALLINT, (i * 100000)::INTEGER, i * 10000000000, " +
              "i::UTINYINT, i::USMALLINT, i::UINTEGER, i::UBIGINT, i * 1.5, (i / 4)::FLOAT, " +
              "i % 2 = 0, 'x' || i, CASE WHEN i % 3 = 0 THEN NULL ELSE i END, 'a,b', 'q\"uote' " +
              "FROM range(100) t(i)"

    assert_eq(agrees(con, sql), 100, "a hundred rows")
end mixed_agrees

@test("a result of several chunks is read whole, and the sum of 1..N is N(N+1)/2")
sum_closed_form()
    val con = fresh()
    val n: i64 = 1000000
    val r = run(con, s"SELECT i FROM range(1, ${n + 1}) t(i)")
    var total: i64 = 0
    var chunks = 0

    loop
        val ch = r.next() match
            Some(x) -> x
            None -> break

        for x in ch.column(0).i64s().unwrap() do total += x
        chunks += 1

    assert_eq(total, n * (n + 1) / 2, "summed over the views")
    assert(chunks > 400, s"in many chunks of at most 2048 rows ($chunks)")

    // DuckDB's own SUM of a BIGINT is a HUGEINT, read here as an i128.
    val s = run(con, s"SELECT sum(i), avg(i) FROM range(1, ${n + 1}) t(i)").next().unwrap()

    assert_eq(s.column(0).i128s().unwrap()[0], i128(n) * i128(n + 1) / 2, "SUM, as a HUGEINT")
    assert_eq(s.column(1).f64s().unwrap()[0], f64(n + 1) / 2.0, "AVG")
end sum_closed_form

@test("a sum past i64 is exact in a HUGEINT")
sum_past_i64()
    val con = fresh()
    val s = run(con, "SELECT sum(9223372036854775807) FROM range(1000)").next().unwrap()

    assert_eq(s.column(0).i128s().unwrap()[0], i128(9223372036854775807i64) * 1000, "a thousand i64::MAX")
end sum_past_i64

// ## NULLs

@test("NULL in every column type is the mask's, and every reader says so")
nulls_everywhere()
    val con = fresh()
    val types = ["BOOLEAN", "TINYINT", "SMALLINT", "INTEGER", "BIGINT", "UTINYINT", "USMALLINT",
                 "UINTEGER", "UBIGINT", "HUGEINT", "UHUGEINT", "FLOAT", "DOUBLE", "VARCHAR", "BLOB",
                 "DECIMAL(4,1)", "DECIMAL(9,2)", "DECIMAL(18,3)", "DECIMAL(38,4)", "DATE", "TIME",
                 "TIMESTAMP", "TIMESTAMPTZ", "INTERVAL", "INTEGER[]"]
    var sql = "SELECT "

    for i in 0..<types.len
        if i > 0 then sql = s"$sql, "
        sql = s"${sql}CASE WHEN i = 1 THEN NULL ELSE NULL END::${types[i]}"

    val ch = run(con, s"$sql FROM range(2) t(i)").next().unwrap()

    assert_eq(ch.columns(), types.len, "a column per type")

    for col in 0..<ch.columns()
        val v = ch.column(col)

        for row in 0usize..<2
            assert(v.is_null(row), s"${types[col]} row $row is NULL")
            assert(!v.valid(row), s"and not valid")

        assert(v.validity().is_some(), s"${types[col]} has a mask")

    assert(ch.column(13).text(0).unwrap().is_none(), "text answers None")
    assert(ch.column(14).bytes(0).is_none(), "bytes answers None")
    assert(ch.column(18).decimal(0).unwrap().is_none(), "decimal answers None")

    // And the mask is per row: only row 1 is NULL here.
    val mixed = run(con, "SELECT CASE WHEN i = 1 THEN NULL ELSE i END FROM range(3) t(i)").next().unwrap().column(0)

    assert(mixed.valid(0) && mixed.is_null(1) && mixed.valid(2), "row 1 alone")
end nulls_everywhere

// ## Strings

@test("a string of 12 bytes is inlined and one of 13 is not, and both read back whole")
string_boundary()
    val con = fresh()
    val words = ["", "a", "abcd", "abcdefghijk", "abcdefghijkl", "abcdefghijklm", "a string much longer than twelve bytes"]
    var sql = "SELECT * FROM (VALUES "

    for i in 0..<words.len
        if i > 0 then sql = s"$sql, "
        sql = s"$sql($i, '${words[i]}')"

    val ch = run(con, s"$sql) t(n, w) ORDER BY n").next().unwrap()
    val col = ch.column(1)
    val raw: *c.StringT = ptr_cast(c.vector_data(col.vec))

    for i in 0..<words.len
        assert_eq(col.text(i).unwrap().unwrap(), words[i], s"word $i")
        assert_eq(col.bytes(i).unwrap().len, words[i].len, s"word $i's length")
        assert_eq(c.string_is_inlined(raw[i]), words[i].len <= 12, s"DuckDB's own inlining of word $i")
end string_boundary

@test("text is a copy, so it outlives its chunk")
text_outlives_chunk()
    val con = fresh()
    var kept: Buf[string] = buf()

    for _ in 0..<3
        val ch = run(con, "SELECT 'a string longer than twelve bytes' || i FROM range(4) t(i)").next().unwrap()

        kept.push(ch.column(0).text(3).unwrap().unwrap())

    assert_eq(kept[2], "a string longer than twelve bytes3", "read after every chunk was destroyed")
end text_outlives_chunk

// ## Wide numbers

@test("HUGEINT's edges, as i128, agree with the CLI")
hugeint_edges()
    val con = fresh()
    val sql = "SELECT * FROM (VALUES (-170141183460469231731687303715884105727::HUGEINT - 1), " +
              "(170141183460469231731687303715884105727::HUGEINT), (0::HUGEINT), (-1::HUGEINT), " +
              "(18446744073709551616::HUGEINT), (-18446744073709551616::HUGEINT))"

    assert_eq(agrees(con, sql), 6, "six edges")

    val ch = run(con, sql).next().unwrap()

    assert_eq(ch.column(0).i128s().unwrap()[0], -170141183460469231731687303715884105727 - 1, "the minimum")
    assert_eq(ch.column(0).i128s().unwrap()[4], i128(1) << 64, "2^64: the upper half is 1")

    val u = run(con, "SELECT 340282366920938463463374607431768211455::UHUGEINT").next().unwrap()

    assert_eq(u.column(0).u128s().unwrap()[0], 340282366920938463463374607431768211455, "UHUGEINT's maximum")
end hugeint_edges

@test("DECIMAL at each of its four storage widths agrees with the CLI")
decimal_edges()
    val con = fresh()
    val sql = "SELECT -999.9::DECIMAL(4,1), 9999999.99::DECIMAL(9,2), -999999999999.999999::DECIMAL(18,6), " +
              "99999999999999999999999999999999999999::DECIMAL(38,0), " +
              "-0.0000000001::DECIMAL(38,10), 0.05::DECIMAL(3,2), 7::DECIMAL(5,0)"

    assert_eq(agrees(con, sql), 1, "one row")

    val ch = run(con, sql).next().unwrap()
    val d = ch.column(3).decimal(0).unwrap().unwrap()

    assert_eq(d.width, 38, "width")
    assert_eq(d.scale, 0, "scale")
    assert_eq(ch.column(0).decimal(0).unwrap().unwrap().value, -9999, "DECIMAL(4,1) unscaled, from an i16")
end decimal_edges

@test("DATE, TIME, TIMESTAMP and INTERVAL read as their DuckDB representations")
dates_and_times()
    val con = fresh()
    val sql = "SELECT DATE '2024-02-29', DATE '1969-12-31', TIMESTAMP '2024-02-29 12:34:56.789012', " +
              "TIME '23:59:59.999999', INTERVAL '14 months 3 days 5 microseconds'"
    val ch = run(con, sql).next().unwrap()
    val (oracle, _) = cli("SELECT date_diff('day', DATE '1970-01-01', DATE '2024-02-29'), " +
                          "epoch_us(TIMESTAMP '2024-02-29 12:34:56.789012')")
    val want = fields(oracle.trim_end())

    assert_eq(s"${ch.column(0).dates().unwrap()[0]}", want[0], "days since the epoch, per the CLI")
    assert_eq(ch.column(1).dates().unwrap()[0], -1, "the day before the epoch")
    assert_eq(s"${ch.column(2).timestamps().unwrap()[0]}", want[1], "microseconds since the epoch, per the CLI")
    assert_eq(ch.column(3).times().unwrap()[0], 86399999999, "a microsecond before midnight")

    val iv = ch.column(4).intervals().unwrap()[0]

    assert_eq((iv.months, iv.days, iv.micros), (14, 3, 5), "an interval's three parts")

    val parts = c.from_date(c.Date(ch.column(0).dates().unwrap()[0]))

    assert_eq((parts.year, parts.month, parts.day), (2024, 2, 29), "DuckDB's own date split, by value")
end dates_and_times

// ## Nested types

@test("LIST, STRUCT, MAP, ARRAY and UNION types describe themselves, and their vectors read")
nested_types()
    val con = fresh()
    val r = run(con, "SELECT [10, 20, 30]::INTEGER[], {'a': 1, 'b': 'x'}, MAP {'k': 1::BIGINT}, " +
                     "[4, 5]::INTEGER[2], union_value(num := 2)::UNION(num INTEGER, str VARCHAR)")

    val l = r.type_of(0)
    assert(l.id() == List && l.child().id() == Integer, "INTEGER[]")

    val s = r.type_of(1)
    assert(s.id() == Struct && s.fields() == 2, "a two-field STRUCT")
    assert_eq((s.field_name(0), s.field_name(1)), ("a", "b"), "its field names")
    assert(s.field_type(0).id() == Integer && s.field_type(1).id() == Varchar, "and types")

    val m = r.type_of(2)
    assert(m.id() == Map && m.key().id() == Varchar && m.value().id() == Bigint, "MAP(VARCHAR, BIGINT)")

    val a = r.type_of(3)
    assert(a.id() == ArrayType && a.array_size() == 2 && a.array_child().id() == Integer, "INTEGER[2]")

    val u = r.type_of(4)
    assert(u.id() == Union && u.members() == 2, "a two-member UNION")
    assert_eq((u.member_name(0), u.member_name(1)), ("num", "str"), "its member names")
    assert(u.member_type(1).id() == Varchar, "and the second is VARCHAR")

    val ch = r.next().unwrap()
    val list = ch.column(0)
    val e = list.lists().unwrap()[0]
    val items = list.elements().i32s().unwrap()

    assert_eq((e.offset, e.length), (0, 3), "one list of three")
    assert_eq((items[0], items[1], items[2]), (10, 20, 30), "its elements, through the child vector")
    assert_eq(ch.column(1).field(1).text(0).unwrap().unwrap(), "x", "STRUCT field b")

    val arr = ch.column(3).elements().i32s().unwrap()

    assert_eq((arr.len, arr[0], arr[1]), (2, 4, 5), "ARRAY's child is rows × size long")
    assert_eq(ch.column(4).field(1).i32s().unwrap()[0], 2, "UNION member num, field 1 after the tag")
end nested_types

// ## Files

@test("a CSV written by sysl and a Parquet written by DuckDB read back, agreeing with the CLI")
files()
    val con = fresh()
    val dir = make_temp_dir("duckdb-test").unwrap()
    val csv = s"$dir/people.csv"
    val parquet = s"$dir/people.parquet"

    write_text_atomic(csv, "id,name,score\n1,ada,9.5\n2,\"lovelace, a\",8.25\n3,,7\n").unwrap()

    val sql = s"SELECT id, name, score FROM '$csv' ORDER BY id"

    assert_eq(agrees(con, sql), 3, "three CSV rows")

    con.exec(s"COPY (SELECT i::BIGINT AS i, 'p' || i AS s FROM range(5000) t(i)) TO '$parquet' (FORMAT parquet)").unwrap()

    val back = s"SELECT i, s FROM '$parquet' ORDER BY i"

    assert_eq(agrees(con, back), 5000, "five thousand Parquet rows")
    remove_dir_all(dir).unwrap()
end files

// ## The appender

@test("a million appended rows equal the same rows inserted by SQL")
appender_million()
    val con = fresh()

    con.exec("CREATE TABLE a (i BIGINT, s VARCHAR, d DOUBLE, h HUGEINT, n INTEGER)").unwrap()
    con.exec("CREATE TABLE b (i BIGINT, s VARCHAR, d DOUBLE, h HUGEINT, n INTEGER)").unwrap()

    val app = con.appender("a").unwrap()

    for i in 0i64..<1000000
        app.add_i64(i).unwrap()
        app.add_text(s"r$i").unwrap()
        app.add_f64(f64(i) * 0.5).unwrap()
        app.add_i128(i128(i) << 70).unwrap()
        if i % 7 == 0 then app.add_null().unwrap() else app.add_i32(i32(i % 1000)).unwrap()
        app.end_row().unwrap()

    app.flush().unwrap()
    con.exec("INSERT INTO b SELECT i, 'r' || i, i * 0.5, i::HUGEINT << 70, " +
             "CASE WHEN i % 7 = 0 THEN NULL ELSE i % 1000 END FROM range(1000000) t(i)").unwrap()

    val diff = run(con, "SELECT (SELECT count(*) FROM a), " +
                        "(SELECT count(*) FROM (SELECT * FROM a EXCEPT ALL SELECT * FROM b)), " +
                        "(SELECT count(*) FROM (SELECT * FROM b EXCEPT ALL SELECT * FROM a))").next().unwrap()

    assert_eq(diff.column(0).i64s().unwrap()[0], 1000000, "a million rows appended")
    assert_eq(diff.column(1).i64s().unwrap()[0], 0, "none of them missing from b")
    assert_eq(diff.column(2).i64s().unwrap()[0], 0, "and none of b's missing from them")
end appender_million

@test("an appender refuses a missing table with DuckDB's sentence, and a short row on end_row")
appender_errors()
    val con = fresh()

    assert_eq(con.appender("nope").unwrap_err().message, "Table \".main.nope\" could not be found", "a missing table")

    con.exec("CREATE TABLE t (i BIGINT, j BIGINT)").unwrap()

    val app = con.appender("t").unwrap()

    app.add_i64(1).unwrap()
    assert_eq(app.end_row().unwrap_err().message, "Call to EndRow before all columns have been appended to!",
              "a row one column short")
end appender_errors

// ## Prepared statements

@test("every typed bind round-trips")
prepared_binds()
    val con = fresh()
    val p = con.prepare("SELECT $1::BIGINT, $2::DOUBLE, $3::VARCHAR, $4::BOOLEAN, $5::HUGEINT, " +
                        "$6::DECIMAL(10,3), $7::DATE, $8::TIMESTAMP, $9::BLOB, $10::INTEGER, $11::INTERVAL, " +
                        "$12::UBIGINT").unwrap()

    assert_eq(p.params(), 12, "twelve parameters")
    p.bind_i64(1, -9223372036854775807).unwrap()
    p.bind_f64(2, 0.1).unwrap()
    p.bind_text(3, "thirteen byte").unwrap()
    p.bind_bool(4, true).unwrap()
    p.bind_i128(5, -(i128(1) << 100)).unwrap()
    p.bind_decimal(6, Decimal(-1234567, 10, 3)).unwrap()
    p.bind_date(7, 19782).unwrap()
    p.bind_timestamp(8, 1709210096789012).unwrap()
    p.bind_blob(9, [0, 255, 0]).unwrap()
    p.bind_null(10).unwrap()
    p.bind_interval(11, Interval(1, 2, 3)).unwrap()
    p.bind_u64(12, 18446744073709551615).unwrap()

    val ch = p.execute().unwrap().next().unwrap()

    assert_eq(ch.column(0).i64s().unwrap()[0], -9223372036854775807, "BIGINT")
    assert_eq(ch.column(1).f64s().unwrap()[0], 0.1, "DOUBLE")
    assert_eq(ch.column(2).text(0).unwrap().unwrap(), "thirteen byte", "VARCHAR")
    assert(ch.column(3).bools().unwrap()[0], "BOOLEAN")
    assert_eq(ch.column(4).i128s().unwrap()[0], -(i128(1) << 100), "HUGEINT")
    assert_eq(ch.column(5).decimal(0).unwrap().unwrap().text(), "-1234.567", "DECIMAL")
    assert_eq(ch.column(6).dates().unwrap()[0], 19782, "DATE")
    assert_eq(ch.column(7).timestamps().unwrap()[0], 1709210096789012, "TIMESTAMP")

    val blob = ch.column(8).bytes(0).unwrap()

    assert_eq((blob.len, blob[0], blob[1], blob[2]), (3, 0, 255, 0), "BLOB, zero bytes and all")
    assert(ch.column(9).is_null(0), "NULL")

    val iv = ch.column(10).intervals().unwrap()[0]

    assert_eq((iv.months, iv.days, iv.micros), (1, 2, 3), "INTERVAL")
    assert_eq(ch.column(11).u64s().unwrap()[0], 18446744073709551615, "UBIGINT")

    // Rebound and rerun without preparing again.
    p.clear().unwrap()
    p.bind_i64(1, 5).unwrap()
    assert(p.execute().is_err(), "eleven unbound parameters refuse to run")
end prepared_binds

// ## Error paths, each with DuckDB's exact sentence

@test("a syntax error is DuckDB's Parser Error, word for word as the CLI prints it")
syntax_error()
    val con = fresh()
    val e = con.query("SELEC 1").unwrap_err()
    val (_, err) = cli("SELEC 1")

    assert_eq(e.message, "Parser Error: syntax error at or near \"SELEC\"\n\nLINE 1: SELEC 1\n        ^", "the sentence")
    assert_eq(e.message, err.trim_end(), "and the CLI's")
    assert(e.kind == Parser, "a parser error")
    assert_eq(con.prepare("SELEC 1").unwrap_err().message, e.message, "prepare says the same")
end syntax_error

@test("a bind of the wrong type fails at execute, and one past the last parameter at the bind")
bind_mismatch()
    val con = fresh()
    val p = con.prepare("SELECT ?::INTEGER + 1").unwrap()

    p.bind_text(1, "abc").unwrap()

    val e = p.execute().unwrap_err()

    assert_eq(e.message, "Conversion Error: Could not convert string 'abc' to INT32\n\nLINE 1: SELECT ?::INTEGER + 1\n                ^", "the conversion")
    assert(e.kind == Conversion, "a conversion error")
    assert_eq(p.bind_i64(5, 1).unwrap_err().message,
              "Invalid Input Error: Can not bind to parameter number 5, statement only has 1 parameter(s)", "an index past the end")
end bind_mismatch

@test("a missing file is DuckDB's IO Error, as the CLI says it")
missing_file()
    val con = fresh()
    val e = con.query("SELECT * FROM 'no-such-file.csv'").unwrap_err()
    val (_, err) = cli("SELECT * FROM 'no-such-file.csv'")

    assert_eq(e.message, "IO Error: No files found that match the pattern \"no-such-file.csv\"", "the sentence")
    assert_eq(e.message, err.trim_end(), "and the CLI's")
    assert(e.kind == Io, "an IO error")
end missing_file

@test("a closed connection refuses every call rather than handing DuckDB a null handle")
closed_connection()
    val con = fresh()
    val p = con.prepare("SELECT 1").unwrap()

    con.close()
    con.close()
    assert_eq(con.query("SELECT 1").unwrap_err().message, "the connection is closed", "query")
    assert_eq(con.prepare("SELECT 1").unwrap_err().message, "the connection is closed", "prepare")
    assert_eq(con.appender("t").unwrap_err().message, "the connection is closed", "appender")
    assert_eq(p.execute().unwrap_err().message, "the connection is closed", "a statement prepared before")
end closed_connection

@test("open applies settings, and refuses one DuckDB does not know")
settings()
    val db = open(":memory:", [Setting("threads", "3")]).unwrap()
    val con = db.connect().unwrap()

    assert_eq(run(con, "SELECT current_setting('threads')").next().unwrap().column(0).i64s().unwrap()[0], 3, "threads")
    assert_eq(open(":memory:", [Setting("no_such_option", "1")]).unwrap_err().message,
              "Invalid Input Error: The following options were not recognized: no_such_option",
              "an unknown option, refused by open with DuckDB's sentence")
    assert(open("/no/such/dir/x.db").is_err(), "a database in a directory that is not there")
end settings

// ## A scalar function written in sysl

// What the function's calls write, shared across DuckDB's threads.
struct Seen
    calls: Atomic[u64]
    rows: Atomic[u64]
    first: Atomic[u64]
    others: Atomic[u64]

@test("a sysl scalar function runs on several of DuckDB's threads and its answers are right")
udf_parallel()
    val db = open(":memory:", [Setting("threads", "4")]).unwrap()
    val con = db.connect().unwrap()
    val seen: &sync Seen = Seen(Atomic(0), Atomic(0), Atomic(0), Atomic(0))

    con.register_scalar("twice", [Bigint], Bigint, (input, out) ->
        val me = current().id

        seen.calls.add(1)
        seen.rows.add(u64(input.size()))
        if seen.first.cas(0, me) != 0 && seen.first.load() != me then seen.others.add(1)

        val xs = input.column(0)
        val vals = xs.i64s().unwrap()
        val ys = out.out_i64s().unwrap()

        for i in 0..<input.size()
            if xs.is_null(i) then out.set_null(i) else ys[i] = vals[i] * 2
        Ok(())).unwrap()

    val n: i64 = 10000000

    con.exec(s"CREATE TABLE t AS SELECT range AS i FROM range($n)").unwrap()

    val r = run(con, "SELECT sum(twice(i)) FROM t").next().unwrap()

    assert_eq(r.column(0).i128s().unwrap()[0], i128(n) * i128(n - 1), "2 * (0 + … + n-1)")
    assert_eq(seen.rows.load(), u64(n), "every row went through it")
    assert(seen.calls.load() > 1, "in many chunks")
    assert(seen.others.load() > 0, "and more than one thread called it")

    val nul = run(con, "SELECT twice(NULL::BIGINT), twice(21)").next().unwrap()

    assert(nul.column(0).is_null(0), "NULL in, NULL out")
    assert_eq(nul.column(1).i64s().unwrap()[0], 42, "21 in, 42 out")
end udf_parallel

@test("a scalar function's Err fails the query with its message")
udf_error()
    val con = fresh()

    con.register_scalar("boom", [Integer], Integer, (_, _) -> Err("the function said no")).unwrap()

    val e = con.query("SELECT boom(1)").unwrap_err()

    assert_eq(e.message, "Invalid Input Error: the function said no", "the message reaches the caller")
    assert(e.kind == InvalidInput, "as DuckDB classifies it")
end udf_error

// ## The README's example, compiled

@test("the README's example")
readme_example()
    val db = open().unwrap()
    val con = db.connect().unwrap()
    val r = con.query("SELECT i, i * 2.5::DOUBLE AS x FROM range(10) t(i)").unwrap()
    var total = 0.0

    loop
        val chunk = r.next() match
            Some(ch) -> ch
            None -> break

        val ids = chunk.column(0).i64s().unwrap()
        val xs = chunk.column(1).f64s().unwrap()

        for i in 0..<chunk.size() do total += f64(ids[i]) + xs[i]

    assert_eq(total, 45.0 + 112.5, "the sum of both columns")
    assert(version().starts_with("v1."), "a DuckDB 1.x")
end readme_example
